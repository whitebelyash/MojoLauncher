<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:orientation="vertical"
    >
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="true"
        android:scrollbarThumbVertical="@color/minebutton_color">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/fragment_padding_medium">

            <ImageView
                android:id="@+id/vs_editor_instance_icon"
                android:layout_width="@dimen/_50sdp"
                android:layout_height="@dimen/_50sdp"
                android:layout_marginTop="@dimen/padding_heavy"
                android:paddingHorizontal="@dimen/profile_editor_image_padding"
                android:paddingVertical="@dimen/profile_editor_image_padding"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@tools:sample/avatars" />

            <ImageView
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                android:src="@drawable/ic_px_edit"
                android:background="@drawable/background_icon_edit"
                app:layout_constraintBottom_toBottomOf="@+id/vs_editor_instance_icon"
                app:layout_constraintEnd_toEndOf="@+id/vs_editor_instance_icon"/>

            <TextView
                android:id="@+id/vs_editor_profile_name_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profiles_profile_name"
                app:layout_constraintBottom_toTopOf="@+id/vs_editor_instance_name"
                app:layout_constraintStart_toStartOf="@+id/vs_editor_instance_name" />

            <EditText
                android:id="@+id/vs_editor_instance_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_large"
                android:background="@drawable/background_line"
                android:textSize="@dimen/_13ssp"
                android:ems="10"
                android:hint="@string/unnamed"
                android:inputType="textPersonName"
                android:paddingHorizontal="@dimen/padding_heavy"
                app:layout_constraintTop_toBottomOf="@+id/vs_editor_instance_icon" />


            <TextView
                android:id="@+id/vs_editor_ctrl_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/default_control"
                app:layout_constraintBottom_toTopOf="@+id/vs_editor_instance_ctrl_spinner"
                app:layout_constraintStart_toStartOf="@+id/vs_editor_instance_ctrl_spinner" />

            <TextView
                android:id="@+id/vs_editor_instance_ctrl_spinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="@dimen/padding_medium"
                android:background="@drawable/background_line"
                android:hint="@string/use_global_default"
                android:paddingHorizontal="@dimen/padding_heavy"
                android:textSize="@dimen/_13ssp"
                app:layout_constraintEnd_toStartOf="@+id/vs_editor_instance_ctrl_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vs_editor_instance_name" />

            <Button
                android:id="@+id/vs_editor_instance_ctrl_button"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:paddingHorizontal="@dimen/padding_large"
                android:text="@string/global_select"
                app:layout_constraintBottom_toBottomOf="@+id/vs_editor_instance_ctrl_spinner"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/vs_editor_instance_ctrl_spinner" />


            <TextView
                android:id="@+id/vs_editor_renderer_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pedit_renderer"
                app:layout_constraintBottom_toTopOf="@+id/vs_editor_instance_renderer"
                app:layout_constraintStart_toStartOf="@+id/vs_editor_instance_renderer" />

            <Spinner
                android:id="@+id/vs_editor_instance_renderer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/background_line"
                android:dropDownWidth="match_parent"
                android:paddingVertical="0px"
                app:layout_constraintTop_toBottomOf="@+id/vs_editor_instance_ctrl_spinner"
                tools:paddingVertical="@dimen/_12sdp" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_8sdp"
                android:paddingHorizontal="@dimen/_8sdp"
                android:rotation="180"
                android:src="@drawable/spinner_arrow"
                app:layout_constraintBottom_toBottomOf="@+id/vs_editor_instance_renderer"
                app:layout_constraintEnd_toEndOf="@+id/vs_editor_instance_renderer"
                app:layout_constraintTop_toTopOf="@+id/vs_editor_instance_renderer" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/fragment_padding_medium"
        android:layout_marginVertical="13dp">
        <com.kdt.mcgui.MineButton
            android:id="@+id/vs_editor_save_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/global_save"
            android:layout_marginEnd="@dimen/padding_medium" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/vs_editor_delete_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/padding_medium"
            android:text="@string/global_delete" />
    </LinearLayout>
</LinearLayout>